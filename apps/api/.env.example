# =============================================================================
# apps/api (NestJS + Prisma) — local / server deployment only
# Not required for apps/web on Vercel (see root .env.example web block).
# Copy to apps/api/.env
# =============================================================================

# Database (local Postgres / Docker)
DATABASE_URL="postgresql://kpbf_rec:kpbf_rec@localhost:5432/kpbf_rec?schema=public"

# JWT (legacy cookie refresh + local JWT endpoints)
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars________"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars______"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_REFRESH_COOKIE_NAME="refreshToken"

PORT=4000
CORS_ORIGINS="*"
TRUST_PROXY=false

# Redis (BullMQ rankings queue)
REDIS_URL="redis://localhost:6379"
RANKINGS_USE_QUEUE=false

# Legacy local media
MEDIA_BASE_URL="http://localhost:4000/media"
MEDIA_STORAGE_PATH="./tmp/media"

SEED_ADMIN_EMAIL="admin@kpbf-rec.test"
SEED_ADMIN_PASSWORD="admin1234"

# Supabase bridge (API verifies Supabase JWTs; optional if not using Supabase auth on API)
AUTH_ENABLE_SUPABASE_AUTOLINK=false
AUTH_ALLOW_SUPABASE_EMAIL_MATCH_LOGIN=false

SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your_anon_key"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/keys"
SUPABASE_JWT_ISSUER="https://your-project-id.supabase.co/auth/v1"
SUPABASE_JWT_AUD="authenticated"

# Server-only — never expose to Next.js client
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

SUPABASE_STORAGE_BUCKET_MEDIA="media"
