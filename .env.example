# =========================
# API (NestJS) - core
# =========================

# Database
DATABASE_URL="postgresql://kpbf_rec:kpbf_rec@localhost:5432/kpbf_rec?schema=public"

# JWT + refresh tokens (legacy backend JWT endpoints may remain)
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_REFRESH_COOKIE_NAME="refreshToken"

# App
PORT=4000
CORS_ORIGINS="*"
TRUST_PROXY=false

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"
RANKINGS_USE_QUEUE=false

# =========================
# Media storage (legacy local disk)
# =========================
MEDIA_BASE_URL="http://localhost:4000/media"
MEDIA_STORAGE_PATH="./tmp/media"

# Seed admin user
SEED_ADMIN_EMAIL="admin@kpbf-rec.test"
SEED_ADMIN_PASSWORD="admin1234"

# =========================
# Supabase auth migration controls
# =========================
AUTH_ENABLE_SUPABASE_AUTOLINK=false
AUTH_ALLOW_SUPABASE_EMAIL_MATCH_LOGIN=false

# =========================
# Supabase (shared) - JWT verification + storage URL building
# =========================
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your_anon_key"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/keys"
SUPABASE_JWT_ISSUER="https://your-project-id.supabase.co/auth/v1"
SUPABASE_JWT_AUD="authenticated"

# Supabase (API only) - service role (never expose to web)
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Supabase Storage
SUPABASE_STORAGE_BUCKET_MEDIA="media"

# =========================
# Web (Next.js) - public config
# =========================
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_public_anon_key"

