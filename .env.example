# Backend database
DATABASE_URL="postgresql://kpbf_rec:kpbf_rec@localhost:5432/kpbf_rec?schema=public"

# JWT + refresh tokens
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# App
PORT=4000

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"
RANKINGS_USE_QUEUE=false

# Media storage
MEDIA_BASE_URL="http://localhost:4000/media"
MEDIA_STORAGE_PATH="./tmp/media"

# Seed admin user
SEED_ADMIN_EMAIL="admin@kpbf-rec.test"
SEED_ADMIN_PASSWORD="admin1234"

